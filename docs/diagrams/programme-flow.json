  "cards": [
    {
      "dot": "cyan",
      "title": "Cleaning is the point",
      "items": [
        "1.39M rows ask what pixels cannot answer - country, season, climate zone",
        "Captions carry the same contamination inline, so they are redacted",
        "Cloud, shadow and snow patches come out via the v2.0 metadata flags"
      ]
    },
    {
      "dot": "emerald",
      "title": "The evidence preamble",
      "items": [
        "About 45% of records carry measurements the model must not contradict",
        "Decisive and orthogonal only - never one that argues with its own gold",
        "Measured from each patch by the same functions inference will use"
      ]
    },
    {
      "dot": "violet",
      "title": "The delta, and what blocks it",
      "items": [
        "Base and adapted are two rows of one harness, same seed and prompts",
        "Normalised against each metric's own range before aggregation",
        "Adapt needs a GPU; every accelerated quota on the account is zero"
      ]
    }
  ]
