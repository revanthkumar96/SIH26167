  "cards": [
    {
      "dot": "cyan",
      "title": "Six controller stages",
      "items": [
        "check - bands, CRS, co-registration IoU at least 0.90",
        "route - task inferred from the imagery, never declared",
        "select - permitted parameters only, enforced by the registry",
        "execute, fuse, report - bounded re-planning, streamed trace"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence injection",
      "items": [
        "Specialists run before the model, so measurements reach its prompt",
        "format_evidence() renders the preamble it must not contradict",
        "A contradicted answer is re-asked once, then the run stops"
      ]
    },
    {
      "dot": "violet",
      "title": "Parity and honest degradation",
      "items": [
        "stretch_to_uint8 and PROMPT_VERSION shared by both paths",
        "A tool without its bands reports applicable:false and the run goes on",
        "4-band Cartosat yields NDWI but never NDBI - built-up comes from SAR"
      ]
    }
